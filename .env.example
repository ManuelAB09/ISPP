# ==========================================
# Configuración Base de Datos (PostgreSQL)
# ==========================================
SPRING_DATASOURCE_URL=ruta_db
SPRING_DATASOURCE_USERNAME=tu_usuario
SPRING_DATASOURCE_PASSWORD=tu_contraseña

# ==========================================
# Configuración Servidor de Correo (SMTP)
# ==========================================
EMAIL=tu_correo@gmail.com
PASSWORD_EMAIL=tu_password_de_aplicacion_google

# ==========================================
# Configuración Google Classroom (OAuth2)
# ==========================================
GOOGLE_CLASSROOM_CLIENT_ID=cliente
GOOGLE_CLASSROOM_CLIENT_SECRET=secreto
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:8080/oauth2/callback/google-classroom

# ==========================================
# Configuración de Stripe (Pagos)
# ==========================================
STRIPE_API_KEY=key
STRIPE_WEBHOOK_SECRET=secret
STRIPE_SUCCESS_URL=uri
STRIPE_CANCEL_URL=uri
STRIPE_PRICE_PREMIUM=premium
