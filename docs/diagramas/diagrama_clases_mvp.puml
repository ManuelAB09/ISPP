@startuml Diagrama_Clases_MVP
!theme plain
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor LightGreen
}

title Diagrama de Clases - MeerKatters (Solo MVP)

' ============ ENUMS ============
enum TipoPlan {
    FREE
    PREMIUM
}

enum TipoGrupo {
    COMUNIDAD_PUBLICA
    GRUPO_PRIVADO
}

enum TipoPlanComunidad {
    FREE
    PREMIUM
    CORPORATIVO
}

enum EstadoComunidad {
    ACTIVA
    CONGELADA
}

enum RolComunidad {
    ADMIN
    MIEMBRO
}

enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

enum EstadoAsistencia {
    CONFIRMADA
    CANCELADA
}

enum TipoTransaccion {
    PAGO_VERIFICACION
    PAGO_PROFESOR
    SUSCRIPCION
    COMISION
}

enum EstadoTransaccion {
    PENDIENTE
    COMPLETADA
    FALLIDA
}

enum EstadoInvitacion {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

' ============ CLASES MVP ============

class Usuario {
    - id: Long
    - email: String
    - password: String
    - nombre: String
    - foto: String
    - bio: String
    - intereses: List<String>
    - googleId: String
    - visibleEnListados: Boolean
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - Máximo 3 comunidades como admin (Free)
    - OAuth con Google para Classroom
    --
    + registrar(): void
    + iniciarSesion(): String
    + cerrarSesion(): void
    + actualizarPerfil(): void
    + cambiarPassword(): void
    + eliminarCuenta(): void
    + vincularGoogleClassroom(): void
}

class Profesor {
    - id: Long
    - especialidades: List<String>
    - tarifaHora: BigDecimal
    - verificado: Boolean
    - classroomId: String
    - bio: String
    - disponibilidad: String
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - Pago para verificación (RF-12)
    - Solo verificados aparecen destacados
    - Classroom se asocia al grupo
      al ser contratado (RF-15)
    --
    + crearPerfil(): void
    + editarPerfil(): void
    + solicitarVerificacion(): void
    + conectarClassroom(): void
}

class Comunidad {
    - id: Long
    - nombre: String
    - descripcion: String
    - tipoGrupo: TipoGrupo
    - imagen: String
    - maxMiembros: Integer
    - tipoPlan: TipoPlanComunidad
    - estado: EstadoComunidad
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - COMUNIDAD_PUBLICA: meetings siempre
      visibles, NO puede contratar profesor
    - GRUPO_PRIVADO: puede ocultar meetings,
      puede contratar profesor
    - Premium amplía aforo (RF-32)
    --
    + crear(): void
    + configurarPrivacidad(): void
    + verificarLimiteMiembros(): Boolean
    + eliminar(): void
    + agregarCategoria(): void
    + contratarProfesor(): void
    + buscarPorNombre(): List<Comunidad>
}

class ClassroomAssociation {
    - id: Long
    - classroomId: String
    - permisos: String
    - linkedAt: LocalDateTime
    ==
    <b>Nota:</b>
    Vincula grupo con
    Google Classroom del profesor
    --
    + asociar(): void
    + desvincular(): void
    + sincronizarPermisos(): void
}

class MiembroComunidad {
    - id: Long
    - rol: RolComunidad
    - fechaIngreso: LocalDateTime
    --
    + unirse(): void
    + abandonar(): void
    + expulsar(): void
    + transferirAdmin(): void
    + esAdmin(): Boolean
}

class SolicitudComunidad {
    - id: Long
    - estado: EstadoSolicitud
    - mensaje: String
    - createdAt: LocalDateTime
    --
    + crear(): void
    + aceptar(): void
    + rechazar(): void
}

class Evento {
    - id: Long
    - titulo: String
    - descripcion: String
    - fechaHora: LocalDateTime
    - fechaFin: LocalDateTime
    - ubicacion: String
    - latitud: Double
    - longitud: Double
    - aforo: Integer
    - queLlevar: String
    - visibleEnMapa: Boolean
    - esVirtual: Boolean
    - enlaceVirtual: String
    - cancelado: Boolean
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - Respetar aforo máximo (RF-46)
    - En comunidades públicas siempre
      visible en mapa (RF-47)
    - En grupos privados el organizador
      decide la visibilidad
    --
    + crear(): void
    + editar(): void
    + cancelar(): void
    + verificarAforo(): Boolean
    + obtenerAsistentes(): List<Usuario>
    + contarAsistentes(): Integer
}

class AsistenciaEvento {
    - id: Long
    - estado: EstadoAsistencia
    - createdAt: LocalDateTime
    --
    + confirmar(): void
    + cancelar(): void
}

class InvitacionEvento {
    - id: Long
    - estado: EstadoInvitacion
    - createdAt: LocalDateTime
    --
    + enviar(): void
    + aceptar(): void
    + rechazar(): void
}

class ArchivoAdjunto {
    - id: Long
    - nombre: String
    - url: String
    - tipo: String
    - tamaño: Long
    - classroomLink: String
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - Gestión principal de material
      delegada a Google Classroom (RF-50)
    - Solo adjuntos menores en plataforma
    --
    + adjuntar(): void
    + eliminar(): void
    + vincularEvento(): void
    + enlazarRecursoExterno(): void
}

class TransaccionPago {
    - id: Long
    - tipo: TipoTransaccion
    - monto: BigDecimal
    - moneda: String
    - comision: BigDecimal
    - estado: EstadoTransaccion
    - iniciadoAt: LocalDateTime
    - completadoAt: LocalDateTime
    ==
    <b>Tipos:</b>
    - PAGO_VERIFICACION: profesor (RF-61)
    - PAGO_PROFESOR: sueldo (RF-62)
    - SUSCRIPCION: premium (RF-55)
    - COMISION: % sobre pagos (RF-62)
    --
    + procesar(): void
    + aplicarComision(): void
    + verificarEstado(): EstadoTransaccion
}

class Categoria {
    - id: Long
    - nombre: String
    - descripcion: String
    - orden: Integer
    - icono: String
    --
    + crear(): void
    + editar(): void
    + eliminar(): void
    + reordenar(): void
}

class Suscripcion {
    - id: Long
    - plan: TipoPlan
    - fechaInicio: LocalDate
    - fechaFin: LocalDate
    - activa: Boolean
    - autoRenovar: Boolean
    ==
    <b>Planes (RF-54, RF-55):</b>
    - FREE: funcionalidades básicas
    - PREMIUM: aforo ampliado
    --
    + suscribir(): void
    + cancelar(): void
    + renovar(): void
    + estaActiva(): Boolean
}

class Institucion {
    - id: Long
    - nombre: String
    - email: String
    - logo: String
    - dominio: String
    - planContratado: TipoPlan
    - maxUsuarios: Integer
    - createdAt: LocalDateTime
    ==
    <b>Academias (RF-58, RF-63):</b>
    Plan especial con funcionalidades
    premium a precio reducido
    --
    + registrar(): void
    + contratarPlan(): void
}

' ============ RELACIONES ============

' Usuario relaciones
Usuario "1" -- "0..1" Profesor : tiene perfil >
Usuario "1" -- "0..*" MiembroComunidad : pertenece a >
Usuario "1" -- "0..1" Suscripcion : tiene >
Usuario "1" -- "0..*" Evento : crea >
Usuario "1" -- "0..*" AsistenciaEvento : asiste a >
Usuario "1" -- "0..*" ArchivoAdjunto : adjunta >
Usuario "1" -- "0..*" TransaccionPago : realiza >
Usuario "1" -- "0..*" SolicitudComunidad : solicita >

' Profesor relaciones
Profesor "0..*" -- "0..*" Comunidad : contratado por >
Profesor "1" -- "0..*" TransaccionPago : recibe pagos >
Profesor "1" -- "0..1" ClassroomAssociation : propietario >

' Comunidad relaciones
Comunidad "1" -- "0..*" MiembroComunidad : tiene miembros >
Comunidad "1" -- "1" Usuario : creada por >
Comunidad "1" -- "0..*" Evento : contiene >
Comunidad "1" -- "0..*" ArchivoAdjunto : almacena >
Comunidad "1" -- "0..*" Categoria : organiza >
Comunidad "1" -- "0..*" SolicitudComunidad : recibe >
Comunidad "0..1" -- "0..1" ClassroomAssociation : tiene >
Comunidad "0..*" -- "0..1" Institucion : pertenece a >

' Evento relaciones
Evento "1" -- "0..*" AsistenciaEvento : tiene >
Evento "1" -- "0..*" InvitacionEvento : invita a >
Evento "0..1" -- "0..*" ArchivoAdjunto : asocia >
InvitacionEvento "0..*" -- "1" Usuario : invita a >

' Otras relaciones
ArchivoAdjunto "0..*" -- "0..1" Categoria : pertenece a >
SolicitudComunidad "0..1" -- "0..1" Usuario : respondida por >

' ============ NOTAS ============
note top of Usuario
  <b>Requisitos Aplicables:</b>
  - RNF-02: Contraseñas hasheadas
  - RNF-03: Autenticación con JWT
  - RF-07: OAuth Google Classroom
end note

note top of Comunidad
  <b>Límites Plan Free:</b>
  - RF-18: Máx 3 comunidades
  - RF-19: Miembros limitados
  
  <b>Tipos (RF-17):</b>
  - Pública vs Privada
end note

note right of TransaccionPago
  <b>Integración:</b>
  Stripe (RF-56)
  
  <b>Comisión (RF-62):</b>
  % sobre pagos a profesores
end note

note bottom of ClassroomAssociation
  <b>Google Classroom:</b>
  Material y tareas (RF-50)
  Permisos automáticos (RF-53)
end note

@enduml
