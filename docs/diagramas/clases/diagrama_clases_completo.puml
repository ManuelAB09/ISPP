@startuml Diagrama_Clases_Completo
!theme plain
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor<<MVP>> LightGreen
    BackgroundColor<<Extra>> LightBlue
}

title Diagrama de Clases - MeerKatters (Completo)

' ============ ENUMS ============
enum TipoPlan {
    FREE
    PREMIUM
}

enum TipoGrupo {
    COMUNIDAD_PUBLICA
    GRUPO_PRIVADO
}

enum RolComunidad {
    ADMIN
    MIEMBRO
}

enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

enum EstadoAsistencia {
    CONFIRMADA
    CANCELADA
}

enum TipoTransaccion {
    PAGO_VERIFICACION
    PAGO_TUTOR
    SUSCRIPCION
    COMISION
}

enum EstadoTransaccion {
    PENDIENTE
    COMPLETADA
    FALLIDA
}

enum EstadoInvitacion {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

enum TipoNotificacion {
    EVENTO_NUEVO
    SOLICITUD_ACEPTADA
    MENSAJE_CHAT
    ARCHIVO_NUEVO
    RECORDATORIO
    SUSCRIPCION_EXPIRA
    COMUNIDAD_CONGELADA
    TUTOR_CONTRATADO
}

enum TipoPlanComunidad {
    FREE
    PREMIUM
    CORPORATIVO
}

enum EstadoComunidad {
    ACTIVA
    CONGELADA
}

' ============ CLASES MVP ============

class Usuario <<MVP>> {
    - id: Long
    - email: String
    - password: String
    - nombre: String
    - foto: String
    - bio: String
    - intereses: List<String>
    - googleId: String
    - visibleEnListados: Boolean
    - plan: TipoPlan
    - esTutor: Boolean
    - createdAt: LocalDateTime
    --
    + registrar(): void
    + iniciarSesion(): String
    + cerrarSesion(): void
    + actualizarPerfil(): void
    + cambiarPassword(): void
    + eliminarCuenta(): void
    + recuperarPassword(): void
    + vincularGoogleClassroom(): void
}

class Tutor <<MVP>> {
    - id: Long
    - especialidades: List<String>
    - tarifaHora: BigDecimal
    - verificado: Boolean
    - classroomConectado: Boolean
    - bio: String
    - disponibilidad: String
    - createdAt: LocalDateTime
    --
    + crearPerfil(): void
    + editarPerfil(): void
    + solicitarVerificacion(): void
    + conectarClassroom(): void
    + desconectarClassroom(): void
    + mostrarEnListado(): List<Tutor>
}

class Comunidad <<MVP>> {
    - id: Long
    - nombre: String
    - descripcion: String
    - tipoGrupo: TipoGrupo
    - imagen: String
    - maxMiembros: Integer
    - miembrosActuales: Integer
    - tipoPlan: TipoPlanComunidad
    - estado: EstadoComunidad
    - tieneClassroom: Boolean
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - COMUNIDAD_PUBLICA: meetings siempre
      visibles, no puede contratar tutor
    - GRUPO_PRIVADO: puede ocultar meetings,
      puede contratar tutor
    --
    + crear(): void
    + configurarPrivacidad(): void
    + verificarLimiteMiembros(): Boolean
    + eliminar(): void
    + agregarCategoria(): void
    + contratarTutor(): void
    + congelar(): void
    + descongelar(): void
}

class ClassroomAssociation <<MVP>> {
    - id: Long
    - classroomId: String
    - permisos: String
    - linkedAt: LocalDateTime
    --
    + asociar(): void
    + desvincular(): void
    + sincronizarPermisos(): void
}

class MiembroComunidad <<MVP>> {
    - id: Long
    - rol: RolComunidad
    - fechaIngreso: LocalDateTime
    --
    + unirse(): void
    + abandonar(): void
    + expulsar(): void
    + transferirAdmin(): void
    + cambiarRol(): void
}

class SolicitudComunidad <<MVP>> {
    - id: Long
    - estado: EstadoSolicitud
    - mensaje: String
    - createdAt: LocalDateTime
    --
    + crear(): void
    + aceptar(): void
    + rechazar(): void
}

class Evento <<MVP>> {
    - id: Long
    - titulo: String
    - descripcion: String
    - fechaHora: LocalDateTime
    - fechaFin: LocalDateTime
    - aforo: Integer
    - asistentesConfirmados: Integer
    - queLlevar: String
    - visibleEnMapa: Boolean
    - esVirtual: Boolean
    - enlaceVirtual: String
    - cancelado: Boolean
    - motivoCancelacion: String
    - createdAt: LocalDateTime
    ==
    <b>Reglas de Negocio:</b>
    - En comunidades públicas siempre
      visibleEnMapa = true
    - En grupos privados el organizador
      decide la visibilidad
    --
    + crear(): void
    + editar(): void
    + cancelar(): void
    + verificarAforo(): Boolean
    + contarAsistentes(): Integer
    + generarEnlaceVirtual(): String
}

class Ubicacion <<MVP>> {
    - id: Long
    - nombre: String
    - latitud: Double
    - longitud: Double
}

class AsistenciaEvento <<MVP>> {
    - id: Long
    - estado: EstadoAsistencia
    - createdAt: LocalDateTime
    --
    + confirmar(): void
    + cancelar(): void
}

class InvitacionEvento <<MVP>> {
    - id: Long
    - estado: EstadoInvitacion
    - createdAt: LocalDateTime
    --
    + enviar(): void
    + aceptar(): void
    + rechazar(): void
}

class ArchivoAdjunto <<MVP>> {
    - id: Long
    - nombre: String
    - url: String
    - tipo: String
    - tamaño: Long
    - classroomLink: String
    - createdAt: LocalDateTime
    ==
    <b>Nota:</b>
    Gestión principal de material
    delegada a Google Classroom
    --
    + adjuntar(): void
    + eliminar(): void
    + vincularEvento(): void
    + enlazarRecursoExterno(): void
}

class TransaccionPago <<MVP>> {
    - id: Long
    - tipo: TipoTransaccion
    - monto: BigDecimal
    - moneda: String
    - comision: BigDecimal
    - estado: EstadoTransaccion
    - iniciadoAt: LocalDateTime
    - completadoAt: LocalDateTime
    --
    + procesar(): void
    + aplicarComision(): void
    + reembolsar(): void
    + verificarEstado(): EstadoTransaccion
}

class Categoria <<MVP>> {
    - id: Long
    - nombre: String
    - descripcion: String
    - orden: Integer
    - icono: String
    --
    + crear(): void
    + editar(): void
    + eliminar(): void
    + reordenar(): void
}

class Suscripcion <<MVP>> {
    - id: Long
    - plan: TipoPlan
    - fechaInicio: LocalDate
    - fechaFin: LocalDate
    - activa: Boolean
    - autoRenovar: Boolean
    --
    + suscribir(): void
    + cancelar(): void
    + renovar(): void
    + estaActiva(): Boolean
}

' ============ CLASES MVP (Chat es Extra) ============
class Mensaje <<Extra>> {
    - id: Long
    - contenido: String
    - editado: Boolean
    - createdAt: LocalDateTime
    --
    + enviar(): void
    + editar(): void
    + eliminar(): void
}

class Institucion <<MVP>> {
    - id: Long
    - nombre: String
    - email: String
    - logo: String
    - dominio: String
    - planContratado: TipoPlan
    - maxUsuarios: Integer
    - createdAt: LocalDateTime
    ==
    <b>Nota:</b>
    Academias con plan especial
    y funcionalidades premium
    --
    + registrar(): void
    + contratarPlan(): void
    + invitarUsuario(): void
}

class InvitacionCorporativa <<Extra>> {
    - id: Long
    - email: String
    - token: String
    - estado: EstadoInvitacion
    - fechaEnvio: LocalDateTime
    - fechaExpiracion: LocalDateTime
    --
    + enviar(): void
    + aceptar(): void
    + cancelar(): void
}

class Notificacion <<Extra>> {
    - id: Long
    - tipo: TipoNotificacion
    - titulo: String
    - mensaje: String
    - leida: Boolean
    - enviadaPorEmail: Boolean
    - createdAt: LocalDateTime
    --
    + crear(): void
    + marcarLeida(): void
    + enviarEmail(): void
}

class PreferenciasNotificacion <<Extra>> {
    - id: Long
    - emailEventos: Boolean
    - emailMensajes: Boolean
    - emailArchivos: Boolean
    - emailSolicitudes: Boolean
    --
    + actualizar(): void
}

class GrabacionReunion <<Extra>> {
    - id: Long
    - url: String
    - duracion: Integer
    - tamaño: Long
    - classroomUploadUrl: String
    - createdAt: LocalDateTime
    ==
    <b>Nota:</b>
    Las grabaciones se suben
    a Google Classroom
    --
    + guardar(): void
    + eliminar(): void
    + subirAClassroom(): void
}

' ============ RELACIONES ============

' Usuario relaciones
Usuario "1" -- "0..1" Tutor : tiene perfil >
Usuario "1" -- "0..*" MiembroComunidad : pertenece a >
Usuario "1" -- "0..1" Suscripcion : tiene >
Usuario "1" -- "0..*" Evento : crea >
Usuario "1" -- "0..*" AsistenciaEvento : asiste a >
Usuario "1" -- "0..*" ArchivoAdjunto : adjunta >
Usuario "1" -- "0..*" TransaccionPago : realiza >
Usuario "1" -- "0..*" Mensaje : envía >
Usuario "1" -- "0..*" SolicitudComunidad : solicita >
Usuario "1" -- "0..*" Notificacion : recibe >
Usuario "1" -- "0..1" PreferenciasNotificacion : configura >

' Tutor relaciones
Tutor "0..*" -- "0..*" Comunidad : contratado por >
Tutor "1" -- "0..*" TransaccionPago : recibe pagos >
Tutor "1" -- "0..1" ClassroomAssociation : propietario >

' Comunidad relaciones
Comunidad "1" -- "0..*" MiembroComunidad : tiene >
Comunidad "1" -- "1" Usuario : creada por >
Comunidad "1" -- "0..*" Evento : contiene >
Comunidad "1" -- "0..*" ArchivoAdjunto : almacena >
Comunidad "1" -- "0..*" Categoria : organiza >
Comunidad "1" -- "0..*" Mensaje : contiene >
Comunidad "1" -- "0..*" SolicitudComunidad : recibe >
Comunidad "0..1" -- "0..1" ClassroomAssociation : tiene >
Comunidad "0..*" -- "0..1" Institucion : pertenece a >

' Evento relaciones
Evento "1" -- "0..*" AsistenciaEvento : tiene >
Evento "1" -- "0..*" InvitacionEvento : invita a >
Evento "0..1" -- "0..*" ArchivoAdjunto : asocia >
Evento "1" -- "0..1" GrabacionReunion : tiene >
Ubicacion "0..1" -- "0..*" Evento : localiza >
InvitacionEvento "0..*" -- "1" Usuario : invita a >

' Otras relaciones
ArchivoAdjunto "0..*" -- "0..1" Categoria : pertenece a >
Institucion "1" -- "0..*" InvitacionCorporativa : genera >
SolicitudComunidad "0..1" -- "1" Usuario : respondida por >

' ============ LEYENDA ============
legend right
  |= Color |= Tipo |
  | <#LightGreen> | MVP |
  | <#LightBlue> | Extra |
endlegend

' ============ NOTAS ============
note top of Tutor
  <b>Verificación (RF-12):</b>
  Los tutores pagan para
  aparecer verificados y destacados
  
  <b>Integración Classroom (RF-15):</b>
  Conectan su Classroom para
  asociarlo automáticamente
  al ser contratados
end note

note right of Comunidad
  <b>Tipos de Grupo (RF-17):</b>
  - COMUNIDAD_PUBLICA: sin tutor,
    meetings siempre en mapa
  - GRUPO_PRIVADO: puede contratar
    tutor, meetings ocultables
    
  <b>Premium (RF-32):</b>
  Amplía aforo y funcionalidades
end note

note bottom of TransaccionPago
  <b>Tipos de Transacción:</b>
  - PAGO_VERIFICACION: tutor
  - PAGO_TUTOR: sueldo
  - SUSCRIPCION: premium
  - COMISION: % sobre pagos
  
  <b>Integración:</b>
  Stripe (RF-56)
end note

note right of ClassroomAssociation
  <b>Integración Google Classroom:</b>
  Gestión de material y tareas
  delegada a Classroom (RF-50)
  
  Permisos automáticos al
  contratar tutor (RF-53)
end note

@enduml
