#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# pre-commit hook — Linting automático antes de cada commit
# Proyecto: MeerKatters
#
# Flujo frontend: ESLint sobre archivos staged.
# Flujo backend:  1) Spotless auto-formatea el código Java.
#                 2) Si hay cambios de formato, pide re-staging.
#                 3) Si el código ya estaba formateado, ejecuta Checkstyle.
# Solo lanza cada herramienta si hay archivos relevantes staged.
#
# Instalar ejecutando:
#   git config core.hooksPath .githooks
# ============================================================

echo "Ejecutando comprobaciones pre-commit..."

ERRORS=0

# ── Frontend: ESLint ────────────────────────────────────────
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/**/*.js' 'frontend/**/*.jsx' 2>/dev/null || true)

if [[ -n "$FRONTEND_FILES" ]]; then
  echo "  Comprobando ESLint (frontend)..."
  if [ -f "frontend/node_modules/.bin/eslint" ]; then
    # Convertir rutas relativas al frontend
    RELATIVE_FILES=$(echo "$FRONTEND_FILES" | sed 's|^frontend/||')
    cd frontend
    if ! echo "$RELATIVE_FILES" | xargs ./node_modules/.bin/eslint --no-error-on-unmatched-pattern; then
      echo "  [FALLO] ESLint ha encontrado errores."
      ERRORS=1
    fi
    cd ..
  else
    echo "  [AVISO] ESLint no instalado. Ejecuta 'npm install' en frontend/."
  fi
fi

# ── Backend: Spotless (auto-format) + Checkstyle ────────────
BACKEND_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/src/**/*.java' 2>/dev/null || true)

if [[ -n "$BACKEND_FILES" ]]; then
  if [ -f "backend/pom.xml" ]; then
    cd backend

    # Detectar comando Maven
    MVNCMD=mvn
    if [ ! -x "$(command -v mvn)" ]; then
      if [ -x "./mvnw" ]; then
        MVNCMD="./mvnw"
      elif [ -x "./mvnw.cmd" ]; then
        MVNCMD="./mvnw.cmd"
      fi
    fi

    # 1) Auto-formatear con Spotless
    echo "  Formateando código Java con Spotless..."
    $MVNCMD spotless:apply -q 2>/dev/null || echo "  [AVISO] Spotless no pudo aplicarse. Continuando sin formateo automático."

    cd ..

    # 2) Si Spotless modificó algún archivo staged, avisar y pedir re-staging
    REFORMATTED=$(git diff --name-only -- 'backend/src/**/*.java' 2>/dev/null || true)
    if [[ -n "$REFORMATTED" ]]; then
      echo ""
      echo "  [AVISO] Spotless ha reformateado los siguientes archivos:"
      echo "$REFORMATTED" | sed 's/^/    /'
      echo ""
      echo "  Revisa los cambios con 'git diff' y ejecuta 'git add' sobre ellos antes de volver a hacer commit."
      ERRORS=1
    else
      # 3) Checkstyle — solo reglas que Spotless no puede auto-corregir
      echo "  Comprobando Checkstyle (backend)..."
      cd backend
      if ! $MVNCMD checkstyle:check -q 2>/dev/null; then
        echo "  [FALLO] Checkstyle ha encontrado errores."
        ERRORS=1
      fi
      cd ..
    fi
  else
    echo "  [AVISO] No se encontró backend/pom.xml."
  fi
fi

# ── Resultado ───────────────────────────────────────────────
if [[ $ERRORS -ne 0 ]]; then
  echo ""
  echo "[FALLO] Pre-commit fallido. Corrige los errores antes de hacer commit."
  exit 1
fi

echo "[OK] Todas las comprobaciones pre-commit pasaron."
exit 0
